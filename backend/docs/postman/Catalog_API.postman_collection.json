{
    "info": {
        "name": "Catalog API - Crosh",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Categories",
            "item": [
                {
                    "name": "Get Categories",
                    "request": {
                        "method": "GET",
                        "url": "{{API_URL}}/categories"
                    }
                },
                {
                    "name": "Get Category By Id",
                    "request": {
                        "method": "GET",
                        "url": "{{API_URL}}/categories/{{categoryId}}"
                    }
                },
                {
                    "name": "Create Category",
                    "request": {
                        "method": "POST",
                        "url": "{{API_URL}}/categories",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\": \"Shoes\", \"slug\": \"shoes\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Update Category",
                    "request": {
                        "method": "PATCH",
                        "url": "{{API_URL}}/categories/{{categoryId}}",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\": \"Running Shoes\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Delete Category",
                    "request": {
                        "method": "DELETE",
                        "url": "{{API_URL}}/categories/{{categoryId}}"
                    }
                }
            ]
        },
        {
            "name": "Collections",
            "item": [
                {
                    "name": "Get Collections",
                    "request": {
                        "method": "GET",
                        "url": "{{API_URL}}/collections"
                    }
                },
                {
                    "name": "Get Collection By Id",
                    "request": {
                        "method": "GET",
                        "url": "{{API_URL}}/collections/{{collectionId}}"
                    }
                },
                {
                    "name": "Create Collection",
                    "request": {
                        "method": "POST",
                        "url": "{{API_URL}}/collections",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\": \"Summer 2026\", \"slug\": \"summer-2026\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Update Collection",
                    "request": {
                        "method": "PATCH",
                        "url": "{{API_URL}}/collections/{{collectionId}}",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"isFeatured\": true}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Delete Collection",
                    "request": {
                        "method": "DELETE",
                        "url": "{{API_URL}}/collections/{{collectionId}}"
                    }
                }
            ]
        },
        {
            "name": "Products",
            "item": [
                {
                    "name": "Get Products",
                    "request": {
                        "method": "GET",
                        "url": "{{API_URL}}/products"
                    }
                },
                {
                    "name": "Get Product By Id",
                    "request": {
                        "method": "GET",
                        "url": "{{API_URL}}/products/{{productId}}"
                    }
                },
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "url": "{{API_URL}}/products",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\": \"Nike Air\", \"slug\": \"nike-air\", \"category\": \"{{categoryId}}\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Update Product",
                    "request": {
                        "method": "PATCH",
                        "url": "{{API_URL}}/products/{{productId}}",
                        "body": {
                            "mode": "raw",
                            "raw": "{\"status\": \"Active\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "DELETE",
                        "url": "{{API_URL}}/products/{{productId}}"
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "API_URL",
            "value": "http://localhost:3000/api/v1"
        }
    ]
}