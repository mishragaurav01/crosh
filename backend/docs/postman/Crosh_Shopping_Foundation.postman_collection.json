{
    "info": {
        "name": "Crosh Shopping Foundation API",
        "description": "Endpoints to manage wishlist, cart, and coupons.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api/v1",
            "type": "string"
        },
        {
            "key": "token",
            "value": "<YOUR_JWT_TOKEN>",
            "type": "string"
        },
        {
            "key": "guestId",
            "value": "guest-xyz",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Cart",
            "item": [
                {
                    "name": "Get Cart",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "disabled": true
                            },
                            {
                                "key": "x-guest-id",
                                "value": "{{guestId}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/cart",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "cart"
                            ]
                        }
                    }
                },
                {
                    "name": "Add Item",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "x-guest-id",
                                "value": "{{guestId}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"productId\": \"<PRODUCT_ID>\",\n  \"variantId\": \"<VARIANT_ID>\",\n  \"quantity\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/cart",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "cart"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Coupons",
            "item": [
                {
                    "name": "Create Coupon (Admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"code\": \"SUMMER10\",\n  \"type\": \"Percentage\",\n  \"value\": 10,\n  \"minOrderAmount\": 500\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/coupons",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "coupons"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Wishlist",
            "item": [
                {
                    "name": "Get Wishlist",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/wishlist",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "wishlist"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}